# 使い方:
#   1. このファイルを .github/workflows/geocode.yml としてリポジトリにコピーする
#   2. {{ADDRESS_QUERIES}} を、国土地理院に問い合わせたい住所（"沖縄県〜" 形式）のbashリストに置き換える
#   3. 店名から探したい場合は {{OSM_NAME_PATTERN}} を店名の一部（正規表現）に置き換える
#      （周辺のランドマークで探したいときは bbox を店の推定エリアに絞ったクエリに書き換える）
#   4. main にコミット＆プッシュし、mcp__github__actions_run_trigger の run_workflow で実行
#   5. 数十秒〜1分待ってから git pull すると geo_result.json が届く
#   6. 使い終わったら geo_result.json とこのファイル自体を git rm してコミットし、後片付けする
name: geocode
on: workflow_dispatch
permissions:
  contents: write
jobs:
  geo:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: query
        run: |
          python3 - <<'PY'
          import json, urllib.parse, urllib.request, time

          UA = "okinawa-soba-blog/1.0"

          def get(url, data=None):
              req = urllib.request.Request(url, data=data, headers={"User-Agent": UA})
              with urllib.request.urlopen(req, timeout=90) as r:
                  return r.read().decode()

          result = {"gsi": [], "osm": []}

          # --- 国土地理院 住所検索API（番地レベルの実座標）
          queries = {{ADDRESS_QUERIES}}
          for q in queries:
              try:
                  r = json.loads(get(
                      "https://msearch.gsi.go.jp/address-search/AddressSearch?q="
                      + urllib.parse.quote(q)
                  ))
                  for f in r[:3]:
                      result["gsi"].append({
                          "q": q,
                          "title": f["properties"]["title"],
                          "lat": f["geometry"]["coordinates"][1],
                          "lng": f["geometry"]["coordinates"][0],
                      })
              except Exception as e:
                  result["gsi"].append({"q": q, "error": str(e)})
              time.sleep(0.15)

          # --- OpenStreetMap Overpass（店名や周辺施設で探す）
          name_pattern = "{{OSM_NAME_PATTERN}}"
          if name_pattern:
              ql = (
                  '[out:json][timeout:90];'
                  'nwr["name"~"%s"](26.0,127.5,26.95,128.4);'
                  'out center tags;' % name_pattern
              )
              try:
                  j = json.loads(get(
                      "https://overpass-api.de/api/interpreter",
                      ("data=" + urllib.parse.quote(ql)).encode(),
                  ))
                  for e in j.get("elements", []):
                      t = e.get("tags", {})
                      result["osm"].append({
                          "name": t.get("name"),
                          "lat": e.get("lat") or e.get("center", {}).get("lat"),
                          "lng": e.get("lon") or e.get("center", {}).get("lon"),
                          "addr": t.get("addr:full") or t.get("addr:housenumber"),
                          "amenity": t.get("amenity"),
                      })
              except Exception as e:
                  result["osm"] = [{"error": str(e)}]

          json.dump(result, open("geo_result.json", "w"), ensure_ascii=False, indent=1)
          print("done")
          PY
      - name: commit
        run: |
          git config user.name github-actions
          git config user.email actions@users.noreply.github.com
          git add geo_result.json
          git commit -m "geocode result [skip ci]"
          git push
