# このファイルをコピーして「.env」という名前で保存し、下の行に合鍵を貼り付けてください。
# ここに書いた合鍵は、あんじさんのパソコンの中だけに残ります(ネットには上がりません)。

DISCORD_BOT_TOKEN=ここにDiscordのBotトークンを貼る

# --- ここから下は、基本そのままで大丈夫です ---

# 返事をする相手。空にしておくと、最初に話しかけた人を持ち主として自動で覚えます。
OWNER_USER_ID=

# 作業する場所(空ならこのフォルダのひとつ上=秘書のフォルダ)
WORK_DIR=

# 許可の強さ。acceptEdits = ファイルの書き換えまでは自動、それ以外は控えめ。
PERMISSION_MODE=acceptEdits

# 1回の返事にかける時間の上限(分)
TIMEOUT_MINUTES=15
